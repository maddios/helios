{
	"name": "helios",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"contracts",
		"core"
	],
	"scripts": {
		"test": "jest",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"depcheck": "depcruise contracts/src core/src local --config .dependency-cruiser.js",
		"lint": "npm run typecheck && npm run depcheck",
		"format": "prettier --write .",
		"local:bootstrap": "tsx local/bootstrap.ts",
		"test:local": "jest -c jest.local.config.js",
		"local:standalone:up": "docker compose --profile standalone up -d",
		"local:standalone:down": "docker compose --profile standalone down"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1152.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.0.0",
		"aws-sdk-client-mock": "^4.1.0",
		"dependency-cruiser": "^18.6.0",
		"jest": "^30.5.2",
		"mongodb-memory-server": "^11.3.0",
		"prettier": "^3.9.10",
		"ts-jest": "^29.4.15",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3"
	}
}
