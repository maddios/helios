{
	"name": "helios",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"contracts",
		"core",
		"worker",
		"api",
		"sdk",
		"functions"
	],
	"scripts": {
		"test": "jest",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"depcheck": "depcruise contracts/src core/src worker/src api/src functions/src sdk/src local scripts --config .dependency-cruiser.js",
		"lint": "npm run typecheck && npm run depcheck",
		"format": "prettier --write .",
		"local:bootstrap": "tsx local/bootstrap.ts",
		"test:local": "jest -c jest.local.config.js",
		"test:local:fanOut": "jest -c jest.local.config.js local/test/fanOut.e2e.ts",
		"test:local:worker": "jest -c jest.local.config.js local/test/worker.e2e.ts",
		"test:local:lifecycle": "jest -c jest.local.config.js local/test/lifecycle.e2e.ts",
		"test:local:api": "jest -c jest.local.config.js local/test/api.e2e.ts",
		"test:local:eventbridge": "jest -c jest.local.config.js local/test/eventbridge.e2e.ts",
		"test:local:lambdas": "jest -c jest.local.config.js local/test/lambdas.e2e.ts",
		"test:local:transcribe": "jest -c jest.local.config.js local/test/transcribe.e2e.ts",
		"test:local:scenes": "jest -c jest.local.config.js local/test/scenes.e2e.ts",
		"test:local:images": "jest -c jest.local.config.js local/test/images.e2e.ts",
		"test:openai": "jest -c jest.openai.config.js",
		"local:api": "tsx local/runApi.ts",
		"local:lambdas": "tsx local/lambdaRunner.ts",
		"local:img": "tsx local/imageEdge.ts",
		"local:standalone:up": "docker compose --profile standalone up -d",
		"local:standalone:down": "docker compose --profile standalone down",
		"local:fixtures": "tsx local/fixtures.ts",
		"test:golden": "jest -c jest.golden.config.js",
		"build:worker": "esbuild worker/src/main.ts worker/src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --external:sharp --outdir=dist/worker",
		"build:api": "esbuild api/src/main.ts --bundle --platform=node --target=node22 --format=cjs --external:swagger-ui-express --loader:.md=text --outfile=dist/api/main.js",
		"build:image": "esbuild functions/src/image/handler.ts --bundle --platform=node --target=node22 --format=cjs --external:sharp --outfile=dist/image/handler.js",
		"test:golden:docker": "docker build -t helios-worker:test --target test -f worker/Dockerfile . && docker run --rm -v \"$PWD/local:/app/local:ro\" -v \"$PWD/.cache/fixtures:/app/.cache/fixtures:ro\" helios-worker:test",
		"admin:bootstrap": "tsx core/scripts/bootstrapAdmin.ts",
		"seed:presets": "tsx core/scripts/seedPresets.ts",
		"infra:cdn:render": "tsx scripts/infra/inlineEdgeFunction.ts",
		"eval:scenes": "tsx scripts/eval/runSceneEval.ts --samples .cache/eval/partnrup --out .cache/eval/results"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1152.0",
		"@types/aws-lambda": "8.10.164",
		"@types/jest": "^30.0.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.0.0",
		"aws-sdk-client-mock": "^4.1.0",
		"dependency-cruiser": "^18.6.0",
		"esbuild": "^0.28.2",
		"jest": "^30.5.2",
		"js-yaml": "^4.3.2",
		"mongodb-memory-server": "^11.3.0",
		"prettier": "^3.9.10",
		"ts-jest": "^29.4.15",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3"
	}
}
