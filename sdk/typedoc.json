{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["src/index.ts", "src/admin.ts"],
	"tsconfig": "tsconfig.build.json",
	"readme": "README.md",
	"out": "docs",
	"name": "Helios SDK",
	"excludeInternal": true,
	"excludePrivate": true,
	"treatWarningsAsErrors": true,
	"validation": {
		"notDocumented": true,
		"notExported": true,
		"invalidLink": true
	}
}
